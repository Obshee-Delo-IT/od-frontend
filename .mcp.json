{
  "mcpServers": {
    "figma-mcp-go": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@vkhanhqui/figma-mcp-go@latest"
      ],
      "env": {}
    },
    "coolify": {
      "type": "http",
      "url": "https://coolify.obshee-delo.ru/mcp",
      "headers": {
        "Authorization": "Bearer ${COOLIFY_MCP_TOKEN}"
      }
    }
  }
}
