{
  "name": "od-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:debug": "NODE_OPTIONS='--inspect' next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "prepare": "husky",
    "type-check": "tsc --noEmit",
    "lint:styles": "stylelint \"**/*.css\" --fix --mw 0",
    "generate:types": "openapi-typescript",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "film:export": "node --env-file=.env scripts/export-film-worksheet.mjs",
    "film:import": "node --env-file=.env scripts/import-film-acf.mjs",
    "film:covers": "node --env-file=.env scripts/upload-film-covers.mjs",
    "film:remap": "node scripts/remap-worksheet.mjs",
    "film:kinescope": "node --env-file=.env scripts/match-kinescope.mjs",
    "url:check": "node scripts/check-legacy-urls.mjs",
    "legacy:sweep": "node scripts/legacy-sweep.mjs"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.css": [
      "stylelint \"**/*.css\" --fix --mw 0"
    ]
  },
  "browserslist": [
    ">0.3%",
    "not dead",
    "not op_mini all"
  ],
  "dependencies": {
    "@radix-ui/react-accordion": "1.2.11",
    "@radix-ui/react-navigation-menu": "1.2.11",
    "@radix-ui/themes": "3.2.1",
    "@wordpress/block-library": "9.32.0",
    "clsx": "2.1.1",
    "html-react-parser": "5.2.6",
    "next": "16.0.1",
    "normalize.css": "8.0.1",
    "openapi-fetch": "0.15.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "swiper": "11.2.6"
  },
  "devDependencies": {
    "@csstools/postcss-global-data": "^3.0.0",
    "@next/eslint-plugin-next": "16.0.1",
    "@playwright/test": "^1.60.0",
    "@svgr/webpack": "^8.1.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "22.16.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.7",
    "babel-plugin-react-compiler": "^1.0.0",
    "cssnano": "7.1.0",
    "eslint": "9.30.1",
    "eslint-config-next": "16.0.1",
    "eslint-config-prettier": "10.1.5",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "husky": "9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "16.1.2",
    "openapi-typescript": "7.10.1",
    "postcss": "8.5.6",
    "postcss-nested": "7.0.2",
    "postcss-nested-import": "^1.3.0",
    "postcss-preset-env": "10.2.4",
    "prettier": "3.6.2",
    "stylelint": "16.23.1",
    "stylelint-config-idiomatic-order": "10.0.0",
    "stylelint-config-recommended": "17.0.0",
    "stylelint-order": "7.0.0",
    "typescript": "5.8.3",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.1.7"
  }
}
